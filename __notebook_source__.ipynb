fig, axes = plt.subplots(1, 3, figsize=(17, 5))

sns.scatterplot(data=df_clean, x="UnitPrice", y="TotalPrice", alpha=0.4, ax=axes[0], color="#2a6f97")
axes[0].set_title("UnitPrice vs TotalPrice")
